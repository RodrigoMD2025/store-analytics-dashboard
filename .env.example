# -------------------------------------------------------
# Store Analytics Dashboard - Environment Variables
#
# NEVER commit this file with real values!
# Copy this file as .env and fill in your own credentials.
# -------------------------------------------------------

# === SUPABASE (Backend - OBRIGATÓRIO) ===
# O backend precisa dessas variáveis para autenticar no Supabase.
SUPABASE_URL=your-supabase-project-url
SUPABASE_KEY=your-supabase-service-key

# === SUPABASE (Frontend - apenas para dev local) ===
# Quando usar Docker, esses valores já vêm embutidos na imagem.
# Necessários apenas se rodar `npm run dev` localmente.
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# === TELEGRAM BOT (Backend - opcional) ===
# Necessário apenas para receber relatórios via Telegram.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
AUTHORIZED_CHAT_ID=your-telegram-chat-id
ADMIN_CHAT_ID=your-admin-chat-id

# === GITHUB (Backend - opcional) ===
# Necessário apenas se o backend precisar acessar APIs do GitHub.
GITHUB_TOKEN=your-github-token
